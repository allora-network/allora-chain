# Copy to .env (next to docker-compose.yaml) and uncomment what you need.

# Release image from Docker Hub (default):
# CHAIN_IMAGE=alloranetwork/allora-chain
# CHAIN_VERSION=v0.17.2

# Dev build of any branch/commit from private GHCR (built by the
# "Build and Push dev docker image to GHCR" workflow; needs docker login ghcr.io):
# CHAIN_IMAGE=ghcr.io/allora-network/allora-chain
# CHAIN_VERSION=9d13dd26

# Image built from your working tree: docker build -t allora-chain:local ..
# CHAIN_IMAGE=allora-chain
# CHAIN_VERSION=local
# CHAIN_PLATFORM=linux/arm64   # only if you built it on an arm64 host (Apple Silicon)

# CHAIN_ID=allora-localnet-1
# LOG_LEVEL=info
# LOCALNET_BIND=127.0.0.1
