FROM golang:1.22-bookworm AS builder

ENV GO111MODULE=on
ENV GOMODCACHE=/gocache
ENV BASELINE_VERSION_TAG=v0.17.2
ENV UPGRADE_VERSION_TAG=v0.18.0

ADD . /src
WORKDIR /src

# The baseline comes from a tag in the build context's git history, and the context's
# .git must be a directory: a linked worktree's .git file points outside the context.
RUN test -d .git || (echo "Dockerfile.upgrade needs a full clone: .git is not a directory" >&2; exit 1)
RUN git worktree add --detach /baseline $BASELINE_VERSION_TAG

RUN mkdir -p $GOMODCACHE

# Compiles run outside retry-fetch with GOPROXY=off, so a build error fails on its first attempt.
COPY --chmod=755 scripts/retry-fetch.sh /usr/local/bin/retry-fetch

RUN --mount=type=cache,target=/gocache retry-fetch go mod download
RUN --mount=type=cache,target=/gocache retry-fetch go -C /baseline mod download

# `go install -n` resolves, downloads and verifies every module without compiling.
ENV COSMOVISOR_PKG=cosmossdk.io/tools/cosmovisor/cmd/cosmovisor@v1.6.0
RUN --mount=type=cache,target=/gocache \
    --mount=type=cache,target=/root/.cache/go-build \
    retry-fetch go install -n "$COSMOVISOR_PKG" && \
    GOPROXY=off go install "$COSMOVISOR_PKG"

# Build the baseline version
RUN --mount=type=cache,target=/gocache \
    --mount=type=cache,target=/root/.cache/go-build \
    GOPROXY=off make -C /baseline install

# Build the upgrade binary from the build context, including any uncommitted changes
RUN --mount=type=cache,target=/gocache \
    --mount=type=cache,target=/root/.cache/go-build \
    GOPROXY=off make build-local-edits

RUN cp build/allorad /go/bin/allorad-$UPGRADE_VERSION_TAG

#==============================================================

FROM debian:bookworm-slim AS execution

ENV DEBIAN_FRONTEND=noninteractive \
    USERNAME=appuser \
    APP_PATH=/data

#* curl jq - required for readiness probe and to download genesis
#* bc - required for generate_genesis.sh
RUN apt update && \
    apt -y dist-upgrade && \
    apt install -y --no-install-recommends \
        curl jq \
        tzdata \
        bc \
        ca-certificates && \
    echo "deb http://deb.debian.org/debian testing main" >> /etc/apt/sources.list && \
    apt update && \
    apt install -y --no-install-recommends -t testing \
      zlib1g \
      libgnutls30 \
      perl-base && \
    rm -rf /var/cache/apt/*

#* Install dasel to work with json/yaml/toml configs
ENV DASEL_VERSION="v2.8.1"
ENV DASEL_SHA256="21fda0a4dc3c779c42737eca4b37e4f187d7ab91ba6301eed97b801af84a9ea2"
RUN curl --fail --silent --show-error --location \
        --connect-timeout 20 --max-time 300 --retry 5 --retry-all-errors \
        --output /usr/local/bin/dasel \
        "https://github.com/TomWright/dasel/releases/download/${DASEL_VERSION}/dasel_linux_amd64" && \
    echo "${DASEL_SHA256}  /usr/local/bin/dasel" | sha256sum --check --strict - && \
    chmod a+x /usr/local/bin/dasel

COPY --from=builder /go/bin/* /usr/local/bin/

RUN groupadd -g 1001 ${USERNAME} \
    && useradd -m -d ${APP_PATH} -u 1001 -g 1001 ${USERNAME}

EXPOSE 1317 26656 26657
VOLUME ${APP_PATH}
WORKDIR ${APP_PATH}

USER ${USERNAME}

ENV DAEMON_NAME="allorad"
ENV DAEMON_HOME="/data"

ENTRYPOINT ["cosmovisor" "run" "start"]
