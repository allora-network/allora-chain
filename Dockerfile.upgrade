FROM golang:1.26.10-bookworm AS builder

ENV GO111MODULE=on \
    GOMODCACHE=/gocache \
    GOTOOLCHAIN=local \
    BASELINE_VERSION_TAG=v0.17.0 \
    UPGRADE_VERSION_TAG=v0.18.0

WORKDIR /src

# Retries network-dependent commands with backoff, showing output only on failure.
# The project builds run outside it with GOPROXY=off, so a build error fails on its first attempt.
COPY --chmod=755 <<'EOF' /usr/local/bin/retry-fetch
#!/bin/sh
max_attempts=4
log=$(mktemp)
trap 'rm -f "$log"' EXIT
attempt=1
until "$@" >"$log" 2>&1; do
    status=$?
    tail -n 20 "$log" >&2
    if [ "$attempt" -ge "$max_attempts" ]; then
        echo "retry-fetch: giving up after $attempt attempts (exit $status): $*" >&2
        exit "$status"
    fi
    delay=$((attempt * attempt * 5))
    echo "retry-fetch: attempt $attempt/$max_attempts failed (exit $status), retrying in ${delay}s: $*" >&2
    sleep "$delay"
    attempt=$((attempt + 1))
done
EOF

RUN --mount=type=cache,target=/gocache \
    --mount=type=cache,target=/root/.cache/go-build \
    retry-fetch go install cosmossdk.io/tools/cosmovisor/cmd/cosmovisor@v1.6.0

ADD . /src

# Build the baseline tag without modifying the current working tree.
# A shared local clone keeps repository objects in /src instead of duplicating them.
RUN git clone --quiet --shared --no-checkout /src /baseline && \
    git -C /baseline checkout --quiet "$BASELINE_VERSION_TAG"

WORKDIR /baseline
RUN --mount=type=cache,target=/gocache retry-fetch go mod download
RUN --mount=type=cache,target=/gocache \
    --mount=type=cache,target=/root/.cache/go-build \
    GOPROXY=off make install && \
    cd /src && rm -rf /baseline

# Build the current working tree, including any uncommitted changes.
WORKDIR /src
RUN --mount=type=cache,target=/gocache retry-fetch go mod download
RUN --mount=type=cache,target=/gocache \
    --mount=type=cache,target=/root/.cache/go-build \
    GOPROXY=off make build-local-edits BUILDDIR=/tmp/allora-upgrade && \
    mv /tmp/allora-upgrade/allorad "/go/bin/allorad-$UPGRADE_VERSION_TAG" && \
    rmdir /tmp/allora-upgrade

#==============================================================

FROM debian:bookworm-slim AS execution

ENV DEBIAN_FRONTEND=noninteractive \
    USERNAME=appuser \
    APP_PATH=/data

#* curl jq - required for readiness probe and to download genesis
#* bc - required for generate_genesis.sh
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl jq \
        tzdata \
        bc \
        ca-certificates && \
    rm -rf /var/cache/apt/* /var/lib/apt/lists/*

#* Install dasel to work with json/yaml/toml configs
ENV DASEL_VERSION="v2.8.1"
ENV DASEL_SHA256="21fda0a4dc3c779c42737eca4b37e4f187d7ab91ba6301eed97b801af84a9ea2"
RUN curl --fail --silent --show-error --location \
        --connect-timeout 20 --max-time 300 --retry 5 --retry-all-errors \
        --output /usr/local/bin/dasel \
        "https://github.com/TomWright/dasel/releases/download/${DASEL_VERSION}/dasel_linux_amd64" && \
    echo "${DASEL_SHA256}  /usr/local/bin/dasel" | sha256sum --check --strict - && \
    chmod a+x /usr/local/bin/dasel

COPY --from=builder /go/bin/* /usr/local/bin/

RUN groupadd -g 1001 ${USERNAME} \
    && useradd -m -d ${APP_PATH} -u 1001 -g 1001 appuser

EXPOSE 1317 26656 26657
VOLUME ${APP_PATH}
WORKDIR ${APP_PATH}

USER ${USERNAME}

ENV DAEMON_NAME="allorad"
ENV DAEMON_HOME="/data"

ENTRYPOINT ["cosmovisor", "run", "start"]
